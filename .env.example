# ============================================================
# RG Export configuration template
# Copy to .env and FILL IN REAL VALUES. Never commit real secrets.
# ============================================================

# Shared API token — the controller requires this header (X-API-Token)
# on all mutating endpoints. Use the SAME value on controller, workers and trigger.
API_TOKEN=change-me-to-a-long-random-string

# Controller base URL (on workers/trigger, point at the controller host)
CONTROLLER_URL=http://127.0.0.1:5000

# Controller: auto-timeout for a task stuck in 'progress' (hours)
TASK_TIMEOUT_HOURS=48

# MySQL - readiness check (used by rg_trigger.sh on b80)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=actonia

# ClickHouse - worker export source (local monthly_ranking on each worker)
CH_LOCAL_HOST=127.0.0.1
CH_LOCAL_PASSWORD=change-me
CH_LOCAL_DB=monthly_ranking

# ClickHouse - local monthly_ranking (for cross-validation on controller)
CH_COMPARE_LOCAL_HOST=23.105.14.193
CH_COMPARE_LOCAL_DB=monthly_ranking

# ClickHouse - cloud via S3 (for cross-validation)
CH_COMPARE_CLOUD_HOST=173.236.65.154
CH_COMPARE_CLOUD_USER=default
CH_COMPARE_CLOUD_PASSWORD=change-me

# Alert
ALERT_URL=http://69.175.99.218:8090/api/v1/alert
ALERT_API_KEY=change-me
ALERT_CHANNEL=actoniaalerts

# Seagate S3
SEAGATE_KEY_ID=change-me
SEAGATE_SECRET=change-me
SEAGATE_ENDPOINT=https://s3.us-east-1.clarity1.lyve.seagate.com

# AWS profile for upload
AWS_PROFILE=seagate

# Worker: local directory for temporary parquet files.
# Empty = <ClickHouse user_files_path>/exports. Set to a larger disk if needed,
# e.g. EXPORT_DIR=/data/rg-exports (see rg_worker.sh for path requirements).
EXPORT_DIR=

# Service
PORT=5000
